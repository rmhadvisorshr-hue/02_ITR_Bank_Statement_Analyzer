# Only needed if you run frontend/dev-server.mjs standalone (frontend/npm run
# dev, its own port, e.g. http://localhost:5500) instead of letting this
# server serve the frontend itself. Enables CORS for that one origin.
FRONTEND_DEV_URL=

# Cloudflare R2 - required for persistent report storage (backend/storage/r2.py).
# Create a bucket + API token under Cloudflare dashboard > R2 > Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Also configure a bucket-level Object Lifecycle Rule (R2 bucket > Settings >
# Object Lifecycle Rules) to delete objects under the "reports/" prefix after
# 7 days - this app enforces the same 7-day expiry in its own metadata, but
# the R2-side rule is what actually deletes the stored files.

# Optional: override where the SQLite metadata database is created.
# Defaults to <repo>/data/app.db
ITR_DB_PATH=

# Redis queue + arq worker. Leave unset to run inline within this process
# (the default local-dev experience - no Redis required to run the app).
# e.g. redis://localhost:6379/0, or a hosted instance (Upstash/Redis Cloud/etc).
REDIS_URL=
# Only takes effect when REDIS_URL is also set. Set "false" to keep Redis
# configured for the progress stream but skip the separate arq worker
# process, running jobs inline within FastAPI instead (useful if the worker
# itself is misbehaving, without having to unset REDIS_URL).
ITR_USE_QUEUE=true

# Worker scaling, retries, cleanup.
# How many jobs one worker process runs concurrently.
ITR_WORKER_MAX_JOBS=3
# How many worker sidecar processes this app spawns (only when REDIS_URL is set).
# Worst-case concurrent OS processes across the fleet is roughly
# ITR_WORKER_REPLICAS x ITR_WORKER_MAX_JOBS x 4 - tune both to fit available
# memory, see analysis_worker/settings.py.
ITR_WORKER_REPLICAS=1
# Total attempts (including the first) before a job is given up on. Only
# retries actual crashes (e.g. OOM mid-job) - a cleanly-reported failure
# like "PDF couldn't be parsed" is never retried, see analysis_worker/settings.py.
ITR_WORKER_MAX_TRIES=2

# Automatic cleanup of stale local job directories (work/upload_jobs/<id>,
# left behind by failed/errored jobs - successful ones are already deleted
# immediately after their R2 upload). Defaults to OFF: the sweep still runs
# on a timer and logs exactly what it would delete, but takes no action
# until this is explicitly set to "true". Review a few log cycles first.
ITR_ENABLE_CLEANUP=false
# How old (hours) a local job directory must be before the sweep considers
# it eligible for deletion.
ITR_JOB_RETENTION_HOURS=48
# How often (hours) the sweep runs.
ITR_CLEANUP_INTERVAL_HOURS=1
